# Copy to .env and edit. docker compose reads it automatically.

# ---- Ports ----------------------------------------------------------
# If port 80 is busy on Windows (IIS, Skype...), use 8000.
# On a cloud VM with HTTPS (DOMAIN below), set GATEWAY_PORT=8000 so Caddy can take 80/443.
GATEWAY_PORT=80
SITE_PORT=8080

# ---- Shop accounts ---------------------------------------------------
# Secret that signs login sessions. Any long random string. (setup-vm.sh generates one.)
JWT_SECRET=change-me-please
# Google sign-in: OAuth 2.0 *Web* client ID from Google Cloud Console
# (looks like 1234-abc.apps.googleusercontent.com). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ---- HTTPS on a cloud VM (needed for Google sign-in on a public site) --
# A domain pointing at the VM, e.g. myantfarm.duckdns.org. Start with:
#   docker compose --profile tls up -d
DOMAIN=

# ---- Model -----------------------------------------------------------
MODEL=tinyllama
# Paper settings: temperature 0.7, seed 42.
LLM_TEMPERATURE=0.7
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_S=240
# Multi-agent time budgets (seconds): if the model is overloaded, agents return
# their rule-based findings on time instead of waiting. 0 = wait forever (pure paper mode).
AGENT_LLM_BUDGET_S=25
SYNTH_LLM_BUDGET_S=15
# 1 = run the whole pipeline rules-only (no model calls). For tests only.
LLM_DISABLED=0
